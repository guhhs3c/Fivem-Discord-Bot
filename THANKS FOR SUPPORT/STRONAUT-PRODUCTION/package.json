{
  "name": "stronaut-bot",
  "version": "5.1.0",
  "description": "STRONAUT Discord Bot — FiveM & Gaming Tools",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:production": "node src/index.js",
    "restore:premium": "node src/scripts/restore-premium.js",
    "check": "node --check src/index.js && node --check src/dashboard/server.js && node --check src/dashboard/premium.js && node --check src/config/config.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "cfx-api": "^2.0.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.16",
    "openai": "^6.49.0",
    "qrcode": "^1.5.4",
    "samp-query": "^0.1.5",
    "systeminformation": "^5.31.17"
  }
}
